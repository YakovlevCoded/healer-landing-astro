---
import BaseLayout from './BaseLayout.astro';

interface FaqItem { q: string; a: string; }
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  faq?: FaqItem[];
  heroImage?: string;
  related?: { id: string; title: string }[];
  lang?: string;
  alternates?: { lang: string; path: string }[];
}

const { title, description, pubDate, updatedDate, tags = [], author = 'Bevita Team', faq = [], heroImage, related = [], lang = 'en', alternates = [] } = Astro.props;

// Locale-specific UI chrome and paths.
const T = {
  en: { back: '← Back to blog', by: 'By', updated: 'Updated', faq: 'Frequently asked questions', related: 'Related articles', locale: 'en-US', blogBase: '/blog/', suffix: '— Bevita Blog', ctaTitle: 'Track your health data with Bevita', ctaText: 'Upload lab results, track trends, get AI insights, and share with your doctor. Free to start.' },
  es: { back: '← Volver al blog', by: 'Por', updated: 'Actualizado', faq: 'Preguntas frecuentes', related: 'Artículos relacionados', locale: 'es-ES', blogBase: '/es/blog/', suffix: '— Blog de Bevita', ctaTitle: 'Controla tus datos de salud con Bevita', ctaText: 'Sube tus resultados de laboratorio, sigue tendencias, obtén análisis con IA y compártelos con tu médico. Gratis para empezar.' },
}[lang] ?? null;
const t = T ?? { back: '← Back to blog', by: 'By', updated: 'Updated', faq: 'Frequently asked questions', related: 'Related articles', locale: 'en-US', blogBase: '/blog/', suffix: '— Bevita Blog', ctaTitle: 'Track your health data with Bevita', ctaText: 'Upload lab results, track trends, get AI insights, and share with your doctor. Free to start.' };

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Bevita',
    logo: { '@type': 'ImageObject', url: 'https://bevita.app/favicon.svg' },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: tags.join(', '),
};

const faqSchema = faq.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Inicio' : 'Home', item: new URL(lang === 'es' ? '/es/' : '/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL(t.blogBase, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: canonical },
  ],
};

const schemas = [articleSchema, breadcrumbSchema, ...(faqSchema ? [faqSchema] : [])];
---

<BaseLayout title={`${title} ${t.suffix}`} description={description} schemas={schemas} image={heroImage ?? '/og-default.png'} lang={lang} alternates={alternates}>
  <article class="article">
    <header class="article-header">
      <div class="shell">
        <a href={t.blogBase} class="back-link">{t.back}</a>
        <time>{pubDate.toLocaleDateString(t.locale, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <h1>{title}</h1>
        <p class="article-desc">{description}</p>
        <div class="article-meta">
          <span>{t.by} {author}</span>
          {updatedDate && <span>{t.updated} {updatedDate.toLocaleDateString(t.locale, { year: 'numeric', month: 'long', day: 'numeric' })}</span>}
        </div>
        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
    </header>
    <div class="article-body shell">
      <slot />
    </div>
    {faq.length > 0 && (
      <section class="faq shell">
        <h2>{t.faq}</h2>
        <dl>
          {faq.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}
    {related.length > 0 && (
      <nav class="related shell" aria-label={t.related}>
        <h2>{t.related}</h2>
        <ul>
          {related.map((r) => (
            <li><a href={`${t.blogBase}${r.id}/`}>{r.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
    <div class="blog-cta shell">
      <div class="cta-box">
        <h3>{t.ctaTitle}</h3>
        <p>{t.ctaText}</p>
        <div class="cta-badges">
          <a href="https://apps.apple.com/us/app/bevita-blood-test-labs/id6783030563" class="cta-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            App Store
          </a>
          {/* Google Play — hidden until Android app ships
          <a href="https://play.google.com" class="cta-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.3 2.302-8.636-8.634z"/></svg>
            Google Play
          </a>
          */}
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .shell { max-width: 720px; margin: 0 auto; padding: 0 24px; }
  .article-header { padding: 120px 0 48px; }
  .back-link {
    display: inline-block; font-size: 14px; color: var(--ink-3);
    margin-bottom: 24px; transition: color .2s;
  }
  .back-link:hover { color: var(--forest); }
  time { font-size: 14px; color: var(--ink-3); display: block; margin-bottom: 8px; }
  .article-header h1 { margin-bottom: 12px; }
  .article-desc { font-size: 20px; color: var(--ink-2); max-width: 52ch; }
  .article-meta { display: flex; gap: 16px; margin-top: 16px; font-size: 14px; color: var(--ink-3); }
  .article-tags { display: flex; gap: 6px; margin-top: 12px; }
  .tag {
    padding: 4px 10px; border-radius: 999px; background: var(--forest-soft);
    font-size: 12px; color: var(--forest); font-weight: 500;
  }
  .article-body { padding-block: 48px 96px; }
  .article-body :global(h2) { margin-top: 48px; margin-bottom: 16px; }
  .article-body :global(h3) { margin-top: 32px; margin-bottom: 12px; }
  .article-body :global(p) { margin-bottom: 16px; max-width: 65ch; }
  .article-body :global(ul), .article-body :global(ol) { margin-bottom: 16px; padding-left: 24px; }
  .article-body :global(li) { margin-bottom: 8px; color: var(--ink-2); font-size: 17px; }
  .article-body :global(blockquote) {
    border-left: 3px solid var(--forest); padding-left: 20px;
    margin: 24px 0; font-style: italic; color: var(--ink-2);
  }
  .article-body :global(code) {
    background: var(--tinted); padding: 2px 6px; border-radius: 4px;
    font-size: 14px; font-family: 'JetBrains Mono', monospace;
  }
  .article-body :global(pre) {
    background: var(--ink); color: var(--on-brand); padding: 20px;
    border-radius: 12px; overflow-x: auto; margin: 24px 0;
  }
  .article-body :global(pre code) { background: none; padding: 0; color: inherit; }
  .faq { padding-block: 0 64px; }
  .faq h2 { margin-bottom: 24px; }
  .faq-item { border-top: 1px solid var(--line); padding: 20px 0; }
  .faq-item dt { font-weight: 600; font-size: 18px; margin-bottom: 8px; color: var(--ink); }
  .faq-item dd { margin: 0; color: var(--ink-2); font-size: 16px; line-height: 1.6; }
  .related { padding-block: 0 48px; }
  .related h2 { margin-bottom: 16px; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .related li { border-top: 1px solid var(--line); padding-top: 12px; }
  .related a { color: var(--forest); font-weight: 500; font-size: 17px; }
  .related a:hover { text-decoration: underline; }
  .blog-cta { padding-block: 0 96px; }
  .cta-box {
    background: var(--tinted); border: 1px solid var(--line); border-radius: 16px;
    padding: 32px; text-align: center;
  }
  .cta-box h3 { margin-bottom: 8px; }
  .cta-box p { margin: 0 auto 20px; color: var(--ink-2); font-size: 16px; max-width: 40ch; }
  .cta-badges { display: flex; gap: 12px; justify-content: center; }
  .cta-badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 20px; border-radius: 10px; background: var(--ink);
    color: var(--on-brand); font-size: 13px; font-weight: 500;
    text-decoration: none; transition: transform .2s;
  }
  .cta-badge:hover { transform: translateY(-1px); }
</style>
