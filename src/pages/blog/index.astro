---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog — Healer"
  description="Health insights, biomarker guides, and tips for taking control of your health data."
>
  <section class="blog-hero">
    <div class="shell">
      <span class="eyebrow">blog</span>
      <h1>Health insights<br/>& biomarker guides</h1>
      <p class="lede">Evidence-based articles about understanding your health data, what biomarkers mean, and how to prepare for doctor visits.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {posts.length === 0 ? (
        <div class="empty">
          <p>Articles coming soon. We're preparing evidence-based content about biomarkers, health tracking, and making the most of your lab results.</p>
        </div>
      ) : (
        <div class="post-grid">
          {posts.map((post) => (
            <a href={`/blog/${post.id}/`} class="post-card">
              <time>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero { padding: 120px 0 64px; text-align: center; }
  .blog-hero .lede { margin: 16px auto 0; max-width: 48ch; }
  .shell { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 64px 0; }
  .eyebrow {
    font-family: var(--sans); font-size: 11px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--ink-3); font-weight: 600;
    display: inline-block; margin-bottom: 16px;
  }
  .empty { text-align: center; padding: 64px 0; }
  .empty p { margin: 0 auto; max-width: 48ch; }
  .post-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }
  .post-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 32px; transition: box-shadow .2s, border-color .2s;
    display: flex; flex-direction: column;
  }
  .post-card:hover { box-shadow: var(--shadow-soft); border-color: var(--forest-soft); }
  .post-card time { font-size: 13px; color: var(--ink-3); margin-bottom: 8px; }
  .post-card h3 { font-size: 22px; margin-bottom: 8px; }
  .post-card p { font-size: 15px; flex: 1; }
  .post-tags { display: flex; gap: 6px; margin-top: 16px; flex-wrap: wrap; }
  .tag {
    padding: 4px 10px; border-radius: 999px; background: var(--forest-soft);
    font-size: 12px; color: var(--forest); font-weight: 500;
  }
</style>
