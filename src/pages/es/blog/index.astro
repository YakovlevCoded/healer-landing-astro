---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blogEs')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Blog — Bevita"
  description="Análisis de biomarcadores, guías de salud y consejos para entender tus resultados de laboratorio."
  lang="es"
  alternates={[{ lang: 'en', path: '/blog/' }]}
>
  <section class="blog-hero">
    <div class="shell">
      <span class="eyebrow">blog</span>
      <h1>Salud basada en datos<br/>y guías de biomarcadores</h1>
      <p class="lede">Artículos con base científica sobre cómo entender tus resultados de laboratorio, qué significan tus biomarcadores y cómo prepararte para la consulta médica.</p>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      {posts.length === 0 ? (
        <div class="empty">
          <p>Pronto habrá más artículos. Estamos preparando contenido con base científica sobre biomarcadores y cómo aprovechar tus análisis de sangre.</p>
        </div>
      ) : (
        <div class="post-grid">
          {posts.map((post) => (
            <a href={`/es/blog/${post.id}/`} class="post-card">
              <time>{post.data.pubDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero { padding: 120px 0 64px; text-align: center; }
  .blog-hero .lede { margin: 16px auto 0; max-width: 48ch; }
  .shell { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 64px 0; }
  .eyebrow {
    font-family: var(--sans); font-size: 11px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--ink-3); font-weight: 600;
    display: inline-block; margin-bottom: 16px;
  }
  .empty { text-align: center; padding: 64px 0; }
  .empty p { margin: 0 auto; max-width: 48ch; }
  .post-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 24px;
  }
  .post-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 32px; transition: box-shadow .2s, border-color .2s;
    display: flex; flex-direction: column;
  }
  .post-card:hover { box-shadow: var(--shadow-soft); border-color: var(--forest-soft); }
  .post-card time { font-size: 13px; color: var(--ink-3); margin-bottom: 8px; }
  .post-card h3 { font-size: 22px; margin-bottom: 8px; }
  .post-card p { font-size: 15px; flex: 1; }
  .post-tags { display: flex; gap: 6px; margin-top: 16px; flex-wrap: wrap; }
  .tag {
    padding: 4px 10px; border-radius: 999px; background: var(--forest-soft);
    font-size: 12px; color: var(--forest); font-weight: 500;
  }
</style>
