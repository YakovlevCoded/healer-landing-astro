---
import BaseLayout from '../layouts/BaseLayout.astro';
import ComparisonTable from '../components/ComparisonTable.vue';
import FeatureHighlight from '../components/FeatureHighlight.vue';
import PipelineViz from '../components/DataGraph.vue';
import LottieMascot from '../components/CapybaraSvg.vue';
---

<BaseLayout
  title="Bevita — Your Health, Remembered"
  description="A personal health record that remembers your story. Upload labs, track symptoms, get AI insights — built by a doctor, for people too busy to think about health full-time."
>

  <!-- Hero -->
  <section class="hero">
    <div class="shell">
      <div class="hero-badge">Built by a doctor, not a tech team</div>
      <h1>Your health,<br/><span class="hero-accent">remembered.</span></h1>
      <p class="hero-lede">
        ChatGPT forgets your last lab. Your clinic portal doesn't talk to your other clinic portal. Bevita remembers everything — and connects the dots your doctor doesn't have time to check.
      </p>
      <div class="store-badges">
        <a href="#" class="store-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div><small>Download on the</small><strong>App Store</strong></div>
        </a>
        <a href="#" class="store-badge">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.3 2.302-8.636-8.634z"/></svg>
          <div><small>Get it on</small><strong>Google Play</strong></div>
        </a>
      </div>
      <p class="hero-note" style="text-align:center">Free tier · No credit card · iOS & Android</p>
    </div>
  </section>

  <!-- Mascot -->
  <section class="mascot-section">
    <div class="shell">
      <div class="mascot-card">
        <div class="mascot-visual">
          <LottieMascot client:idle size={180} />
        </div>
        <div class="mascot-text">
          <span class="eyebrow">meet your health buddy</span>
          <h2>This is <span class="mascot-name">Kapi</span></h2>
          <p>A capybara who never forgets. Just like Bevita — he remembers every lab result, every symptom, every trend. Relaxed, reliable, always there when you need him.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="section">
    <div class="shell">
      <span class="eyebrow">the problem</span>
      <h2>Your health data is everywhere.<br/>Your story is nowhere.</h2>
      <div class="problem-grid">
        <div class="problem-card">
          <span class="problem-icon">📁</span>
          <h4>Paper folders</h4>
          <p>Lab results from 2023 buried in a drawer. Can't find them when the new doctor asks.</p>
        </div>
        <div class="problem-card">
          <span class="problem-icon">🏥</span>
          <h4>Clinic portals</h4>
          <p>Each clinic has its own system. Your data is siloed across 3-4 different logins.</p>
        </div>
        <div class="problem-card">
          <span class="problem-icon">🧠</span>
          <h4>ChatGPT</h4>
          <p>Great for one-off questions. Terrible at remembering your ferritin from 6 months ago.</p>
        </div>
        <div class="problem-card">
          <span class="problem-icon">⏰</span>
          <h4>Good intentions</h4>
          <p>You mean to follow up. Then 9 months pass and you've forgotten what was flagged.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Data graph visualization -->
  <section class="section section-pipeline">
    <div class="shell">
      <span class="eyebrow">how bevita works</span>
      <h2>Your health data,<br/>connected in one graph.</h2>
      <p class="section-subtitle">Upload a lab result. Bevita extracts every value, connects it to your symptoms, finds patterns across time, and produces a summary your doctor can actually use.</p>
      <PipelineViz client:idle />
      <p class="graph-footnote">Every node is a real data point from your health record. Every edge is a connection Bevita found.</p>
    </div>
  </section>

  <!-- Comparison -->
  <section class="section section-comparison">
    <div class="shell">
      <span class="eyebrow">why be different</span>
      <h2>Bevita vs ChatGPT vs Everyone Else</h2>
      <p class="section-subtitle">ChatGPT is brilliant for a quick question. But it can't remember your last lab, remind you to retest, or connect your symptoms to your bloodwork over time.</p>
      <ComparisonTable client:load />
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="section section-steps">
    <div class="shell">
      <span class="eyebrow">how it works</span>
      <h2>Three steps to<br/>your health timeline</h2>
      <div class="steps">
        <div class="step">
          <div class="step-icon">📸</div>
          <h3>Upload anything</h3>
          <p>Photo of a paper lab, PDF from your clinic, ultrasound, doctor's notes. Bevita reads them all — in any language.</p>
        </div>
        <div class="step-arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="step">
          <div class="step-icon">🔗</div>
          <h3>AI connects the dots</h3>
          <p>Bevita doesn't just read your latest result. It finds patterns across years and test types — and tells you what it actually means.</p>
        </div>
        <div class="step-arrow">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </div>
        <div class="step">
          <div class="step-icon">📄</div>
          <h3>Share with your doctor</h3>
          <p>Export a clean PDF — everything organized, trends highlighted, questions ready. Hand it over instead of a folder of papers.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="section">
    <div class="shell">
      <span class="eyebrow">features</span>
      <h2>Built for people who<br/>want to stay ahead</h2>
      <div class="features-grid">
        <div class="feature-card feature-card-large">
          <div class="feature-visual">
            <FeatureHighlight client:load />
          </div>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🧠</span>
          <h3>Long-term memory</h3>
          <p>Every upload, every finding, every symptom — stored and searchable. Ask "what about my liver?" and get answers across 3 years of data.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🫀</span>
          <h3>Symptom journal</h3>
          <p>Tap where it hurts on a body map. Log symptoms with location, type, intensity. Bevita maps them against your biomarkers.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🔔</span>
          <h3>Smart reminders</h3>
          <p>"Your last full panel was 9 months ago." Proactive nudges based on your actual health data, not generic schedules.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📋</span>
          <h3>Health Passport PDF</h3>
          <p>Clinical-grade summary: all studies, trend charts, AI insights. Ready for your next appointment.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">👨‍⚕️</span>
          <h3>Doctor share links</h3>
          <p>Generate a view-only URL. Your doctor sees your Health Passport — no app install needed.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🏥</span>
          <h3>Built by a doctor</h3>
          <p>Not a tech team guessing at health features. A doctor who knows what patients need — and what doctors want to see.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof -->
  <section class="section section-proof">
    <div class="shell">
      <div class="proof-grid">
        <div class="proof-card"><span class="proof-num">45+</span><span class="proof-label">biomarkers tracked</span></div>
        <div class="proof-card"><span class="proof-num">7</span><span class="proof-label">languages supported</span></div>
        <div class="proof-card"><span class="proof-num">100%</span><span class="proof-label">private & encrypted</span></div>
        <div class="proof-card"><span class="proof-num">$0</span><span class="proof-label">to get started</span></div>
      </div>
    </div>
  </section>

  <!-- Doctor quote -->
  <section class="section section-quote">
    <div class="shell">
      <div class="quote-card">
        <blockquote>
          "I see patients who bring in folders of papers from 5 different clinics. None of it is organized. None of it connects. Bevita fixes that — and the PDF export alone saves me 10 minutes per visit."
        </blockquote>
        <div class="quote-author">
          <div class="quote-avatar">Dr</div>
          <div>
            <strong>Built by a practicing physician</strong>
            <span>who got tired of reading crumpled lab printouts</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="download" class="section section-cta">
    <div class="shell">
      <div class="cta-mascot">
        <LottieMascot client:idle size={120} />
      </div>
      <h2>Your health deserves<br/>a better memory.</h2>
      <p class="section-subtitle">Start free. Upload your first lab result in 30 seconds.</p>
      <div class="store-badges store-badges-lg">
        <a href="#" class="store-badge store-badge-lg">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          <div><small>Download on the</small><strong>App Store</strong></div>
        </a>
        <a href="#" class="store-badge store-badge-lg">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.3 2.302-8.636-8.634z"/></svg>
          <div><small>Get it on</small><strong>Google Play</strong></div>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="shell">
      <div class="footer-grid">
        <div class="footer-brand">
          <h4>Bevita</h4>
          <p>Your health, remembered.</p>
          <div class="footer-mascot">
            <LottieMascot client:idle size={48} />
          </div>
        </div>
        <div class="footer-links">
          <h5>Product</h5>
          <a href="#features">Features</a>
          <a href="#how-it-works">How it works</a>
          <a href="#download">Download</a>
          <a href="/blog/">Blog</a>
        </div>
        <div class="footer-links">
          <h5>Legal</h5>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
          <a href="/medical/">Medical Disclaimer</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Bevita. Built with care by a doctor.</p>
      </div>
    </div>
  </footer>

</BaseLayout>

<style>
  .hero { padding: 120px 0 80px; text-align: center; }
  @media (max-width: 760px) { .hero { padding: 80px 0 64px; } }
  .hero-badge {
    display: inline-block; padding: 8px 16px; border-radius: 999px;
    background: var(--forest-soft); color: var(--forest); font-size: 13px;
    font-weight: 600; margin-bottom: 24px;
  }
  .hero-accent { color: var(--forest); }
  .hero-lede { margin: 24px auto 0; max-width: 52ch; font-size: 20px; line-height: 1.6; }
  @media (min-width: 760px) { .hero-lede { font-size: 22px; } }
  .store-badges { display: flex; gap: 12px; justify-content: center; margin-top: 32px; }
  .store-badges-lg { gap: 16px; margin-top: 32px; }
  .store-badge {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 12px 24px; border-radius: 12px; background: var(--ink);
    color: var(--on-brand); font-size: 14px; font-weight: 500;
    transition: transform .2s, box-shadow .2s; text-decoration: none;
  }
  .store-badge:hover { transform: translateY(-2px); box-shadow: var(--shadow-emp); }
  .store-badge small { display: block; font-size: 11px; font-weight: 400; opacity: 0.7; text-align: left; }
  .store-badge strong { display: block; font-size: 16px; text-align: left; }
  .store-badge-lg { padding: 14px 28px; font-size: 16px; border-radius: 16px; }
  .hero-note { margin-top: 12px; font-size: 13px; color: var(--ink-3); }

  .mascot-section { padding: 64px 0; }
  .mascot-card {
    display: flex; align-items: center; gap: 48px;
    background: var(--card); border: 1px solid var(--line); border-radius: 24px;
    padding: 48px; max-width: 800px; margin: 0 auto;
  }
  @media (max-width: 760px) {
    .mascot-card { flex-direction: column; text-align: center; padding: 32px; }
  }
  .mascot-visual { flex-shrink: 0; }
  .capybara { filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1)); }
  .mascot-text h2 { margin: 8px 0 12px; }
  .mascot-name { color: var(--forest); font-style: italic; }

  .shell { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section { padding: 96px 0; }
  .section-subtitle { margin: 16px auto 0; max-width: 56ch; text-align: center; }
  @media (max-width: 760px) { .section { padding: 64px 0; } }
  .eyebrow {
    font-family: var(--sans); font-size: 11px; letter-spacing: .18em;
    text-transform: uppercase; color: var(--ink-3); font-weight: 600;
    display: inline-block; margin-bottom: 16px;
  }
  h2 { text-align: center; }

  .problem-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px; margin-top: 48px;
  }
  .problem-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 28px; transition: box-shadow .2s;
  }
  .problem-card:hover { box-shadow: var(--shadow-soft); }
  .problem-icon { font-size: 32px; display: block; margin-bottom: 12px; }
  .problem-card h4 { font-size: 18px; margin-bottom: 8px; }
  .problem-card p { font-size: 15px; }

  .section-pipeline { background: var(--tinted); }
  .graph-footnote { text-align: center; font-size: 13px; color: var(--ink-3); margin-top: 16px; }

  .section-comparison { background: var(--ink); color: var(--on-brand); }
  .section-comparison h2 { color: var(--on-brand); }
  .section-comparison .eyebrow { color: var(--ink-3); }
  .section-comparison .section-subtitle { color: var(--ink-3); }

  .section-steps { background: var(--tinted); }
  .steps {
    display: flex; align-items: flex-start; justify-content: center;
    gap: 16px; margin-top: 48px; flex-wrap: wrap;
  }
  .step {
    flex: 1; min-width: 240px; max-width: 300px; text-align: center;
    background: var(--card); border-radius: 16px; padding: 32px 24px;
    border: 1px solid var(--line);
  }
  .step-icon { font-size: 48px; margin-bottom: 16px; }
  .step h3 { margin-bottom: 8px; }
  .step-arrow { display: flex; align-items: center; padding-top: 48px; color: var(--ink-3); }
  @media (max-width: 900px) { .step-arrow { display: none; } }

  .features-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 20px; margin-top: 48px;
  }
  @media (max-width: 900px) { .features-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .features-grid { grid-template-columns: 1fr; } }
  .feature-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    padding: 28px; transition: box-shadow .2s, border-color .2s;
  }
  .feature-card:hover { box-shadow: var(--shadow-soft); border-color: var(--forest-soft); }
  .feature-card-large {
    grid-column: span 3; padding: 0; overflow: hidden;
    background: var(--forest); border-color: var(--forest);
  }
  @media (max-width: 900px) { .feature-card-large { grid-column: span 2; } }
  @media (max-width: 600px) { .feature-card-large { grid-column: span 1; } }
  .feature-visual { padding: 32px; }
  .feature-icon { font-size: 28px; display: block; margin-bottom: 12px; }

  .section-proof { background: var(--tinted); }
  .proof-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
    max-width: 800px; margin: 0 auto;
  }
  @media (max-width: 760px) { .proof-grid { grid-template-columns: repeat(2, 1fr); } }
  .proof-card { text-align: center; }
  .proof-num { font-family: var(--serif); font-size: 48px; color: var(--forest); display: block; line-height: 1; }
  .proof-label { font-size: 14px; color: var(--ink-3); text-transform: uppercase; letter-spacing: .08em; margin-top: 4px; display: block; }

  .quote-card { max-width: 700px; margin: 0 auto; text-align: center; }
  blockquote {
    font-family: var(--serif); font-size: clamp(20px, 3vw, 28px);
    font-style: italic; line-height: 1.5; color: var(--ink); margin-bottom: 24px;
  }
  .quote-author { display: flex; align-items: center; gap: 12px; justify-content: center; }
  .quote-avatar {
    width: 40px; height: 40px; border-radius: 50%; background: var(--forest);
    color: var(--on-brand); display: flex; align-items: center; justify-content: center;
    font-size: 14px; font-weight: 600;
  }
  .quote-author strong { display: block; font-size: 15px; }
  .quote-author span { font-size: 13px; color: var(--ink-3); }

  .section-cta { text-align: center; }
  .cta-mascot { margin-bottom: 24px; }
  .capybara-small { filter: drop-shadow(0 4px 12px rgba(0,0,0,0.1)); }

  .footer { padding: 64px 0 32px; border-top: 1px solid var(--line); }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px; }
  @media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr; gap: 32px; } }
  .footer-brand h4 { font-size: 20px; margin-bottom: 4px; }
  .footer-brand p { font-size: 14px; color: var(--ink-3); }
  .footer-mascot { margin-top: 16px; opacity: 0.6; }
  .footer-links { display: flex; flex-direction: column; gap: 8px; }
  .footer-links h5 { font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--ink-3); margin-bottom: 4px; }
  .footer-links a { font-size: 15px; color: var(--ink-2); }
  .footer-links a:hover { color: var(--forest); }
  .footer-bottom { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line); }
  .footer-bottom p { font-size: 13px; color: var(--ink-3); }
</style>
